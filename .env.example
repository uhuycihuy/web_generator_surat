# Database Configuration
# Set sesuai dengan environment lokal Anda
DB_HOST=localhost
DB_NAME=generator_surat
DB_USER=root
DB_PASS=

# Application Settings
# Set ke 'production' untuk live server
APP_DEBUG=true
APP_ENV=development

# File Paths
# Lokasi temp directory untuk DOCX processing
TEMP_DIR=/path/to/web_generator_surat/backend/temp

# DIPA Default Value
# Nilai default DIPA untuk Surat Tugas jika tidak diisi
DIPA_DEFAULT=SP DIPA-139.05.1.693321/2025 tanggal 2 Desember 2024
